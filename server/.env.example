# Copy to .env for local work. On Render, set these under the service's Environment tab.
# Never commit real values.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string for the SkillRadius database (its own project and cluster).
MONGODB_URI=

# Sites allowed to call this API from a browser, comma separated.
CORS_ORIGINS=https://skillradius.in,https://www.skillradius.in,http://localhost:8080
